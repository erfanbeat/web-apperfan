{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apperfan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "92a537ff-6d08-49c3-8712-cfe0fbe8be87","database_name": "web-apperdan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4faf1d0a3eb645849a70c429b2df45d9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
